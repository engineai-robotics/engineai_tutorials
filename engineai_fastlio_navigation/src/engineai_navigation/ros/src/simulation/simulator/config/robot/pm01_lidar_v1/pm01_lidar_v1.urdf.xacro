    <link name="LINK_ELBOW_PITCH_R">
        <inertial>
            <origin xyz="0.00302244 -0.00191447 -0.06521149" rpy="0 0 0"/>
            <mass value="1.38162913"/>
            <inertia ixx="0.00587907" ixy="0.00002756" ixz="0.00029909" iyy="0.00593696" iyz="-0.00046493" izz="0.00083539"/>
