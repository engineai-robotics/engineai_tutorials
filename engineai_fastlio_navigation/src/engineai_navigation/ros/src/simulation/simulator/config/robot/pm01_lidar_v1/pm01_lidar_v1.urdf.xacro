        </visual>
        <collision>
            <origin xyz="0.01 -0.008 -0.05" rpy="0 -0.25 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.07"/>
            </geometry>
        </collision>
    </link>
    <joint name="J22_ELBOW_YAW_R" type="revolute">
        <origin xyz="0.013817 -0.0097704 -0.1547" rpy="0 0 0"/>
        <parent link="LINK_ELBOW_PITCH_R"/>
        <child link="LINK_ELBOW_YAW_R"/>
        <axis xyz="-0.21479 0.061909 0.9747"/>
        <!-- The actuator PD supplies damping for this low-inertia axis. -->
        <dynamics damping="0.02" friction="0.02"/>
        <limit lower="-2.618" upper="2.618" effort="61" velocity="35.2"/>
    </joint>

    <link name="LINK_ELBOW_END_R">
        <inertial>
            <mass value="1e-3"/>
            <inertia ixx="1e-12" ixy="0" ixz="0" iyy="1e-12" iyz="0" izz="1e-12"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <joint name="J_FIXED_ELBOW_END_R" type="fixed">
        <origin xyz="0.03 0.02 -0.14" rpy="0 0 0"/>
        <parent link="LINK_ELBOW_YAW_R"/>
        <child link="LINK_ELBOW_END_R"/>
    </joint>

    <link name="LINK_HEAD_YAW">
        <inertial>
            <origin xyz="0.00358213 0.00030109 0.08822633" rpy="0 0 0"/>
            <mass value="0.84510036"/>
            <inertia ixx="0.00428261" ixy="-0.00000647" ixz="0.00048256" iyy="0.00500542" iyz="0.00000033" izz="0.00313801"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(arg mesh_prefix)/LINK_HEAD_YAW.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.1"/>
            </geometry>
        </collision>
    </link>
    <joint name="J23_HEAD_YAW" type="revolute">
        <origin xyz="-0.017638 0 0.2961" rpy="0 0 0"/>
        <parent link="LINK_TORSO_YAW"/>
        <child link="LINK_HEAD_YAW"/>
        <axis xyz="0 0 1"/>
        <dynamics damping="0.6" friction="0.8"/>
        <limit lower="-0.6109" upper="0.6109" effort="61" velocity="35.2"/>
    </joint>

    <link name="camera_link_head"/>
    <joint name="J_FIXED_CAMERA_HEAD" type="fixed">
        <origin xyz="0.07426239 0.0175 0.09676911" rpy="0 0.26420093362 0"/>
        <parent link="LINK_HEAD_YAW"/>
        <child link="camera_link_head"/>
    </joint>

    <link name="camera_link_torso"/>
    <joint name="J_FIXED_CAMERA_TORSO" type="fixed">
        <origin xyz="0.07112178 0.0175 0.01109251" rpy="0 0.86946334308 0"/>
        <parent link="LINK_TORSO_YAW"/>
        <child link="camera_link_torso"/>
    </joint>

    <link name="LIVOX_FRAME">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <!-- Approximate Mid360 sensor envelope. -->
                <cylinder radius="0.0001" length="0.0001"/>
            </geometry>
            <material name="lidar_black">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>
    </link>
    <joint name="J_FIXED_LIVOX_FRAME" type="fixed">
        <!-- Calibrated mount from serial_pm01_edu.urdf. -->
        <origin
            xyz="0.12438064 0 0.21289480"
            rpy="0.872664626 0 1.570796327"/>
        <parent link="LINK_TORSO_YAW"/>
        <child link="LIVOX_FRAME"/>
    </joint>
    <link name="livox_frame"/>
    <joint name="J_FIXED_LIVOX_STANDARD_FRAME" type="fixed">
        <parent link="LIVOX_FRAME"/>
        <child link="livox_frame"/>
    </joint>
    <link name="imu_link"/>
    <joint name="J_FIXED_LIVOX_IMU" type="fixed">
        <!-- IMU chip pose expressed in the LIVOX_FRAME coordinate system. -->
        <origin xyz="0.011 0.02329 -0.04412" rpy="0 0 0"/>
        <parent link="livox_frame"/>
        <child link="imu_link"/>
    </joint>

    <gazebo reference="LINK_FOOT_L">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>
    <gazebo reference="LINK_FOOT_R">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e5</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
    </gazebo>

    <xacro:if value="$(arg enable_sim_sensors)">
    <gazebo reference="LINK_TORSO_YAW">
        <sensor name="policy_imu" type="imu">
            <always_on>true</always_on>
            <update_rate>200.0</update_rate>
            <visualize>false</visualize>
            <plugin
                name="policy_imu"
                filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>
                        ~/out:=$(arg policy_imu_topic)
                    </remapping>
                </ros>
                <frame_name>$(arg policy_imu_frame)</frame_name>
                <gaussian_noise>0.0</gaussian_noise>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="imu_link">
        <sensor name="mid360_imu" type="imu">
            <always_on>true</always_on>
            <update_rate>200.0</update_rate>
            <visualize>false</visualize>
            <plugin name="imu" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=$(arg imu_topic)</remapping>
                </ros>
                <frame_name>$(arg imu_frame)</frame_name>
                <gaussian_noise>0.0</gaussian_noise>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="LINK_BASE">
        <plugin name="pm01_odom_ros" filename="libgazebo_ros_p3d.so">
            <ros>
                <namespace>/pm01</namespace>
            </ros>
            <body_name>LINK_BASE</body_name>
            <frame_name>world</frame_name>
            <topic_name>odom</topic_name>
            <update_rate>100.0</update_rate>
            <gaussian_noise>0.0</gaussian_noise>
        </plugin>
    </gazebo>
    </xacro:if>

    <!-- DART-compatible Mid360 envelope. CustomMsg timing is generated by
         the PointCloud2 bridge because the ODE-only Livox plugin cannot be
         used with the PM01 DART physics configuration. -->
    <xacro:if value="$(arg enable_lidar)">
    <gazebo reference="livox_frame">
        <material>Gazebo/FlatBlack</material>
        <sensor name="mid360" type="gpu_ray">
            <always_on>true</always_on>
            <visualize>$(arg lidar_visualize)</visualize>
            <update_rate>$(arg lidar_update_rate)</update_rate>
            <pose>0 0 0 0 0 0</pose>
            <ray>
                <scan>
                    <horizontal>
                        <samples>$(arg lidar_horizontal_samples)</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265</min_angle>
                        <max_angle>3.14159265</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>$(arg lidar_vertical_samples)</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.12601228</min_angle>
                        <max_angle>0.9637708</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>200.0</max>
                    <resolution>0.002</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.002</stddev>
                </noise>
            </ray>
            <plugin name="mid360_pointcloud" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=$(arg lidar_pointcloud_topic)</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>$(arg lidar_frame)</frame_name>
            </plugin>
        </sensor>
    </gazebo>
    </xacro:if>

    <xacro:if value="$(arg enable_ros2_control)">
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <xacro:gazebo_effort_joint name="J00_HIP_PITCH_L" initial="-0.06"/>
        <xacro:gazebo_effort_joint name="J01_HIP_ROLL_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J02_HIP_YAW_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J03_KNEE_PITCH_L" initial="0.12"/>
        <xacro:gazebo_effort_joint name="J04_ANKLE_PITCH_L" initial="-0.06"/>
        <xacro:gazebo_effort_joint name="J05_ANKLE_ROLL_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J06_HIP_PITCH_R" initial="-0.06"/>
        <xacro:gazebo_effort_joint name="J07_HIP_ROLL_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J08_HIP_YAW_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J09_KNEE_PITCH_R" initial="0.12"/>
        <xacro:gazebo_effort_joint name="J10_ANKLE_PITCH_R" initial="-0.06"/>
        <xacro:gazebo_effort_joint name="J11_ANKLE_ROLL_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J12_WAIST_YAW" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J13_SHOULDER_PITCH_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J14_SHOULDER_ROLL_L" initial="0.15"/>
        <xacro:gazebo_effort_joint name="J15_SHOULDER_YAW_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J16_ELBOW_PITCH_L" initial="-0.25"/>
        <xacro:gazebo_effort_joint name="J17_ELBOW_YAW_L" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J18_SHOULDER_PITCH_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J19_SHOULDER_ROLL_R" initial="-0.15"/>
        <xacro:gazebo_effort_joint name="J20_SHOULDER_YAW_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J21_ELBOW_PITCH_R" initial="-0.25"/>
        <xacro:gazebo_effort_joint name="J22_ELBOW_YAW_R" initial="0.0"/>
        <xacro:gazebo_effort_joint name="J23_HEAD_YAW" initial="0.0"/>
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(arg controllers_file)</parameters>
        </plugin>
        <plugin name="pm01_stand_reset" filename="libpm01_stand_reset.so">
            <hold_until_stand_reset>$(arg hold_until_stand_reset)</hold_until_stand_reset>
        </plugin>
    </gazebo>
    </xacro:if>

</robot>
