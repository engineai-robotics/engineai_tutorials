<?xml version="1.0"?>
<robot name="engineai_pm01" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="lidar_pointcloud_topic" default="/livox/lidar/pointcloud"/>
    <xacro:arg name="lidar_frame" default="livox_frame"/>
    <xacro:arg name="imu_topic" default="/livox/imu"/>
    <xacro:arg name="imu_frame" default="imu_link"/>
    <xacro:arg name="policy_imu_topic" default="/pm01/imu"/>
    <xacro:arg name="policy_imu_frame" default="LINK_TORSO_YAW"/>
    <xacro:arg name="lidar_update_rate" default="10.0"/>
    <xacro:arg name="lidar_horizontal_samples" default="600"/>
    <xacro:arg name="lidar_vertical_samples" default="64"/>
    <xacro:arg name="lidar_visualize" default="false"/>
    <xacro:arg name="controllers_file" default=""/>
    <xacro:arg name="mesh_prefix" default="package://simulator/config/robot/pm01_lidar_v1/meshes"/>
    <xacro:arg name="enable_gazebo_plugins" default="true"/>
    <xacro:arg name="enable_sim_sensors" default="false"/>
    <xacro:arg name="enable_lidar" default="false"/>
    <xacro:arg name="enable_ros2_control" default="true"/>
    <xacro:arg name="hold_until_stand_reset" default="false"/>

    <!-- PD gains from SDK
         assets/config/pm01_edu/rl_walking_example/default.yaml joint_kp / joint_kd -->
    <xacro:macro name="gazebo_effort_joint" params="name initial">
        <joint name="${name}">
            <command_interface name="effort"/>
            <state_interface name="position">
                <param name="initial_value">${initial}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <link name="base_footprint"/>
    <joint name="J_FIXED_BASE" type="fixed">
        <parent link="base_footprint"/>
        <child link="LINK_BASE"/>
    </joint>

    <link name="LINK_BASE">
        <inertial>
            <origin xyz="0.01525750 -0.00001621 -0.02333111" rpy="0 0 0"/>
            <mass value="4.08640035"/>
            <inertia ixx="0.02219920" ixy="-0.00000019" ixz="0.00033788" iyy="0.01686616" iyz="0.00000067" izz="0.01374508"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="$(arg mesh_prefix)/LINK_BASE.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.02 0 -0.042" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.0725"/>
            </geometry>
        </collision>
    </link>
