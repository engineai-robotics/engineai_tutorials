          <material>
            <ambient>0.65 0.67 0.7 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>7.4 0 0.75 0 0 0</pose>
        <inertial><mass>1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>0.2 14.6 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
