          <material>
            <ambient>0.65 0.67 0.7 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Deterministic random layout; the central spawn area stays clear. -->
      <link name="obstacle_1">
        <pose>-4.8 -3.6 0.75 0 0 0.18</pose>
        <inertial><mass>1</mass></inertial>
        <collision name="collision">
          <geometry><box><size>1 1 1.5</size></box></geometry>
