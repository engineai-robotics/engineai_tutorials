        <collision name="collision">
          <geometry><box><size>15 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.65 0.67 0.7 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>
      </link>
