Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Navigation Map (live)
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /navigation_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Use Timestamp: false
    - Class: rviz_default_plugins/RobotModel
      Name: PM01
      Enabled: true
      Value: true
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Links:
        All Links Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Current Heading
      Enabled: true
      Value: true
      Keep: 1
      Angle Tolerance: 0
      Position Tolerance: 0
      Topic:
        Value: /odom
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 0; 150; 220
        Head Length: 0.25
        Head Radius: 0.10
        Shaft Length: 0.40
        Shaft Radius: 0.035
    - Class: rviz_default_plugins/Path
      Name: Navigation Plan
      Enabled: true
      Value: true
      Alpha: 1
      Color: 0; 160; 70
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
      Pose Style: None
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Map
      Name: Local Costmap (optional)
      Enabled: false
      Value: false
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Use Timestamp: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: nav2_rviz_plugins/GoalTool
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Angle: 0
      Scale: 40
      X: 0
      Y: 0
Window Geometry:
  Width: 1120
  Height: 900
  X: 1400
  Y: 90
